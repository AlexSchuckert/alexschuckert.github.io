source "https://rubygems.org"

# Mirrors the gem versions GitHub Pages uses to build the live site,
# including jekyll-remote-theme for the minimal-light theme.
gem "github-pages", ">= 232", group: :jekyll_plugins

# Needed to run `jekyll serve` locally on Ruby 3+.
gem "webrick", "~> 1.8"

# Removed from Ruby's default gems in 3.4+; Jekyll 3.x still requires them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
